SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_SSL_REQUIRE=False
CONN_MAX_AGE=600
DEFAULT_FROM_EMAIL=no-reply@afghantop.local
OTP_CODE=123456
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Send.af provider setup
# 1) Create or edit a TopUpProvider record in Django admin
# 2) Set code=sendaf, name=Send.af, base_url=https://www.send.af/api
# 3) Put your current token in auth_token
# 4) Set extra_config like:
#    {"timeout_seconds": 20, "min_amount": 50, "max_amount": 4000}
